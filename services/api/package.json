{
  "name": "hygrow-api",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "dev": "npm run build && node --watch dist/server.js",
    "migrate": "node dist/migrate.js",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.js",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "bullmq": "6.7.8",
    "fastify": "5.12.8",
    "pg": "8.16.3",
    "redis": "6.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "typescript": "6.0.3"
  }
}
